#!/usr/bin/env python3

"""
gbasf2 exp Data , generic MC submission and download script
version : 2.0,0
Date    : 2026-05-25
Author  : wangzheng
"""

import sys
import subprocess
import time
from datetime import datetime
import argparse
from pathlib import Path
import yaml

def submit_job(exp_name, input_path, project_name, basf2_version, script_path, sandbox_files):
    """Submit job to grid"""
    print(f"Running {exp_name} to Grid! Input: {input_path}")

    # Build the command
    cmd = f"gbasf2 {script_path} -p {project_name}_{exp_name} -s {basf2_version} -i {input_path} -n 1"
    
    # Add sandbox files if provided
    if sandbox_files:
        cmd += f" --input_sandboxfiles {sandbox_files}"
    
    # Add force flag
    cmd += " --force"
    
    # Execute the command
    subprocess.run(cmd, shell=True, check=True)
    time.sleep(1)

def download_data(exp_name, grid_usrname, project_name):
    """Download job data"""
    remote_path = f"/belle/user/{grid_usrname}/{project_name}_{exp_name}"
    
    print(f"Downloading from cloud to KEK... Data {exp_name}")
    cmd_kek = f"gb2_ds_rep {remote_path} -d KEK-DISK-TMP-SE -f"
    subprocess.run(cmd_kek, shell=True, check=True)
    time.sleep(1)
    
    print(f"Downloading from KEK to local... Data {exp_name}")
    # Schedule the download command to run 0.5 hour later using 'at'
    cmd_local = f"echo 'gb2_ds_get --se KEK-DISK-TMP-SE {remote_path} -f' | at now + 1 hour"
    subprocess.run(cmd_local, shell=True, check=True)
    time.sleep(1)


def main():
    current_date = datetime.now().strftime("%d%b%y")  # Default to current date in DDMMMYY format

    # Parse arguments
    parser = argparse.ArgumentParser(description="Submit or download Belle II jobs")
    parser.add_argument("mode", choices=["submit", "download"], help="Mode: submit or download jobs")
    parser.add_argument("--script","-s", help="Path to the analysis script (required for submit mode)")
    parser.add_argument("--config","-c", default="./project_config.yaml", help="Path to the YAML config file")
    parser.add_argument("--date", help="Date in format DDMMMYY (e.g., 25Feb25)", default=current_date)
    parser.add_argument("--number", type=int, choices=range(1, 10), default=1, help="Batch number (1-9)")
    parser.add_argument("--sandbox", help="Additional sandbox files to include (comma-separated)", default = "./STEERING_TOOLS/")
    
    args = parser.parse_args()
    
    # Validate script path when in submit mode
    if args.mode == "submit" and not args.script:
        parser.error("--script is required when mode is 'submit'")
    
    # Validate date format
    try:
        datetime.strptime(args.date, "%d%b%y")
    except ValueError:
        print("Error: Invalid date format or range. Use DDMMMYY format (e.g., 25Feb25)")
        sys.exit(1)

    # Load config
    config_path = Path(args.config)
    if not config_path.exists():
        raise FileNotFoundError(f"Config file not found: {config_path}")
    with config_path.open("r", encoding="utf-8") as config_file:
        config = yaml.safe_load(config_file)
    if not isinstance(config, dict):
        raise RuntimeError(f"Invalid config format: {config_path}")
    experiment_catalog = config.get("experiments", {})
    if not isinstance(experiment_catalog, dict) or not experiment_catalog:
        raise RuntimeError("No experiments configured in the config file")

    current_date = args.date
    project_name = f"{current_date}{config.get('project_name_suffix', '')}{args.number}"
    print(f"Project name: {project_name}")

    for exp_name, input_path in experiment_catalog.items():
        if args.mode == "submit":
            submit_job(exp_name, input_path, project_name, config["basf2_version"],
                       args.script, args.sandbox)
        elif args.mode == "download":
            download_data(exp_name, config["grid_usrname"], project_name)

if __name__ == "__main__":
    main()


